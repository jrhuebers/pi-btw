{
  "name": "pi-btw",
  "version": "0.9.0-fork.2",
  "description": "Parallel Pi side conversations with native transcript rendering and fullscreen mouse scrolling",
  "type": "module",
  "license": "MIT",
  "author": "Dan Bachelder",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jrhuebers/pi-btw.git"
  },
  "homepage": "https://github.com/jrhuebers/pi-btw#readme",
